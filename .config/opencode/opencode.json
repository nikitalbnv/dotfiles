{
  "$schema": "https://opencode.ai/config.json",
  "theme": "gruvbox",
  "autoupdate": false,
  "permission": {
    "external_directory": "allow"
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 15000
    }
  },
  "agent": {
    "learning": {
      "description": "Teaching assistant mode for helping students learn without giving full solutions.",
      "mode": "primary",
      "prompt": "{file:./prompts/learning-system-prompt.md}"
    }
  }
}
